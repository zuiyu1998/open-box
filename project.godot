; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="open-box"
run/main_scene="uid://cflowmenu01"
run/disable_stdout=true
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

ItemCatalog="*res://src/items/item_catalog.gd"
ItemService="*res://src/items/item_service.gd"
GachaCatalog="*res://src/gacha/gacha_catalog.gd"
DeviceCatalog="*res://src/devices/device_catalog.gd"
FlowService="*res://src/flow/flow_service.gd"
GameSession="*res://src/flow/session.gd"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_ai/plugin.cfg")
